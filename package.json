{
  "name": "spotify-clone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev --workspace spotify-clone-server\" \"npm run dev --workspace spotify-clone-client\"",
    "build": "npm run build --workspace spotify-clone-client",
    "seed": "npm run seed --workspace spotify-clone-server",
    "start": "npm run start --workspace spotify-clone-server"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
